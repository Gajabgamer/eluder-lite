<Window x:Class="MyOverlayPOC.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:local="clr-namespace:MyOverlayPOC"
        mc:Ignorable="d"
        Title=""
        Width="480" Height="640"
        MinWidth="320" MinHeight="400"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStyle="None"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        SourceInitialized="MainWindow_SourceInitialized"
        Closing="MainWindow_Closing">

    <Window.Resources>
        <Style x:Key="FlatBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#cccccc"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2a2a2a"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#3a3a3a"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavBtn" TargetType="Button" BasedOn="{StaticResource FlatBtn}">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#aaaaaa"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#252525"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#333333"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ProviderItem" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#cccccc"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1e3a2f"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Thumbnail drag button -->
        <Style x:Key="ThumbBtn" TargetType="Button">
            <Setter Property="Background" Value="#1a1a1a"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="4" BorderBrush="#2a2a2a" BorderThickness="1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#00cccc"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="6" Background="#1a1a1a" BorderBrush="#333333" BorderThickness="1"
            ClipToBounds="True" MouseLeftButtonDown="Window_MouseLeftButtonDown">
        <!-- Outer horizontal split: main | screenshot sidebar -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- ═══════════════════════════════════════════
                 MAIN CONTENT (3 rows)
            ════════════════════════════════════════════════ -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="34"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="40"/>
                </Grid.RowDefinitions>

                <!-- TOP BAR -->
                <Grid Grid.Row="0" Background="#111111" MouseLeftButtonDown="Window_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Provider button -->
                    <Button x:Name="ProviderBtn" Grid.Column="0"
                            Style="{StaticResource FlatBtn}"
                            Background="#1a7a4a"
                            Margin="4,4,2,4" Padding="8,0" Height="26"
                            Click="ProviderBtn_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="ProviderNameText" Text="ChatGPT"
                                       FontSize="12" FontWeight="SemiBold"
                                       Foreground="White" VerticalAlignment="Center"/>
                            <TextBlock Text=" ▼" FontSize="9" Foreground="#ccffcc"
                                       VerticalAlignment="Center" Margin="2,0,0,0"/>
                        </StackPanel>
                    </Button>

                    <!-- Provider popup -->
                    <Popup x:Name="ProviderPopup" PlacementTarget="{Binding ElementName=ProviderBtn}"
                           Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                        <Border Background="#141414" BorderBrush="#333" BorderThickness="1"
                                CornerRadius="4" MinWidth="200">
                            <StackPanel>
                                <Grid Margin="12,8,8,4">
                                    <TextBlock Text="MODELS / TOOLS" FontSize="10"
                                               Foreground="#666" FontWeight="SemiBold"/>
                                    <Button HorizontalAlignment="Right" Style="{StaticResource FlatBtn}"
                                            Width="18" Height="18" FontSize="11" Foreground="#888"
                                            Content="✕" Click="ProviderPopupClose_Click"/>
                                </Grid>
                                <Separator Background="#2a2a2a" Margin="0,2,0,2"/>
                                <Button x:Name="BtnChatGPT" Tag="chatgpt" Style="{StaticResource ProviderItem}" Click="Provider_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="8" Height="8" Fill="#10a37f" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <StackPanel>
                                            <TextBlock Text="ChatGPT" FontSize="13" FontWeight="SemiBold" Foreground="White"/>
                                            <TextBlock Text="OpenAI Web" FontSize="10" Foreground="#888"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="BtnClaude" Tag="claude" Style="{StaticResource ProviderItem}" Click="Provider_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="8" Height="8" Fill="#d97757" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <StackPanel>
                                            <TextBlock Text="Claude" FontSize="13" FontWeight="SemiBold" Foreground="White"/>
                                            <TextBlock Text="Anthropic Web" FontSize="10" Foreground="#888"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="BtnGemini" Tag="gemini" Style="{StaticResource ProviderItem}" Click="Provider_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="8" Height="8" Fill="#4285f4" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <StackPanel>
                                            <TextBlock Text="Gemini" FontSize="13" FontWeight="SemiBold" Foreground="White"/>
                                            <TextBlock Text="Google AI" FontSize="10" Foreground="#888"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="BtnDeepSeek" Tag="deepseek" Style="{StaticResource ProviderItem}" Click="Provider_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="8" Height="8" Fill="#4d6bfe" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <StackPanel>
                                            <TextBlock Text="DeepSeek" FontSize="13" FontWeight="SemiBold" Foreground="White"/>
                                            <TextBlock Text="DeepSeek Web" FontSize="10" Foreground="#888"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Button>
                                <Separator Background="#2a2a2a" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </Popup>

                    <!-- Nav buttons -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="2,0">
                        <Button x:Name="BackBtn" Style="{StaticResource NavBtn}" Content="&lt;" Click="BackBtn_Click"/>
                        <Button x:Name="ForwardBtn" Style="{StaticResource NavBtn}" Content="&gt;" Click="ForwardBtn_Click" Margin="2,0,0,0"/>
                        <Button x:Name="RefreshBtn" Style="{StaticResource NavBtn}" Content="↺" Click="RefreshBtn_Click" Margin="2,0,0,0"/>
                    </StackPanel>

                    <!-- Drag area -->
                    <Border Grid.Column="2" Background="Transparent" Cursor="SizeAll"
                            MouseLeftButtonDown="DragArea_MouseLeftButtonDown">
                        <TextBlock Text="· · ·" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" Foreground="#444" FontSize="14"/>
                    </Border>

                    <!-- Right controls -->
                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,4,0">
                        <!-- Tools Carousel / Guide button -->
                        <Button x:Name="InfoBtn" Style="{StaticResource FlatBtn}"
                                Content="ⓘ" Foreground="#00cccc" FontSize="13" FontWeight="Bold"
                                Width="22" Height="22" Margin="0,0,2,0"
                                ToolTip="Tools &amp; Shortcuts Guide"
                                Click="InfoBtn_Click"/>
                        <!-- Screenshot panel toggle -->
                        <Button x:Name="ToggleShotsBtn" Style="{StaticResource FlatBtn}"
                                Content="⬛" Foreground="#555" FontSize="11"
                                Width="22" Height="22" Margin="0,0,2,0"
                                ToolTip="Toggle screenshot panel"
                                Click="ToggleShotsBtn_Click"/>
                        <Button x:Name="OpacityBtn" Style="{StaticResource FlatBtn}"
                                Content="100%" Foreground="#888" FontSize="10"
                                Padding="5,2" Height="22" Margin="0,0,2,0"
                                Click="OpacityBtn_Click"/>
                        <Button x:Name="HideBtn" Style="{StaticResource FlatBtn}"
                                Content="HIDE" Foreground="#ff6b6b" FontSize="10" FontWeight="SemiBold"
                                Padding="6,2" Height="22" Margin="0,0,2,0"
                                Click="HideBtn_Click"/>
                        <Button x:Name="ClearBtn" Style="{StaticResource FlatBtn}"
                                Content="CLEAR" Foreground="#888" FontSize="10"
                                Padding="6,2" Height="22" Margin="0,0,2,0"
                                Click="ClearBtn_Click"/>
                        <Button x:Name="CloseBtn" Style="{StaticResource FlatBtn}"
                                Background="#cc2222" Width="22" Height="22"
                                Content="✕" Foreground="White" FontSize="11"
                                Click="CloseBtn_Click"/>
                    </StackPanel>
                </Grid>

                <!-- WEBVIEW AREA -->
                <Grid Grid.Row="1">
                    <wv2:WebView2 x:Name="MainWebView" AllowDrop="True"/>

                    <!-- COUNTDOWN OVERLAY -->
                    <Grid x:Name="CountdownOverlay" Visibility="Collapsed" Background="#CC000000">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock x:Name="CountdownText" Text="3"
                                       FontSize="72" FontWeight="Bold"
                                       Foreground="White" HorizontalAlignment="Center"/>
                            <TextBlock Text="Click target field now... (Esc to cancel)"
                                       FontSize="14" Foreground="#aaaaaa"
                                       HorizontalAlignment="Center" Margin="0,8,0,20"/>
                            <Button x:Name="CancelAutoTypeBtn"
                                    Content="Cancel (Esc)" Style="{StaticResource FlatBtn}"
                                    Background="#333" Foreground="#ff6b6b"
                                    FontSize="12" Padding="20,6"
                                    HorizontalAlignment="Center"
                                    Click="CancelAutoType_Click"/>
                        </StackPanel>
                    </Grid>

                    <!-- KEYBOARD SHORTCUTS POPUP (Popup ensures it displays on top of WebView2 HWND) -->
                    <Popup x:Name="ShortcutsPopup"
                           PlacementTarget="{Binding ElementName=MainWebView}"
                           Placement="Center"
                           StaysOpen="False"
                           AllowsTransparency="True">
                        <Border Background="#161616" BorderBrush="#333333" BorderThickness="1"
                                CornerRadius="8" Width="350" Padding="16,14">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Header -->
                                <Grid Grid.Row="0" Margin="0,0,0,12">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="ⓘ " Foreground="#00cccc" FontSize="14" FontWeight="Bold"/>
                                        <TextBlock Text="KEYBOARD SHORTCUTS" FontSize="12" FontWeight="Bold" Foreground="#eeeeee"/>
                                    </StackPanel>
                                    <Button HorizontalAlignment="Right" Style="{StaticResource FlatBtn}"
                                            Width="20" Height="20" FontSize="12" Foreground="#888"
                                            Content="✕" Click="CloseShortcuts_Click"/>
                                </Grid>

                                <!-- Shortcuts List -->
                                <StackPanel Grid.Row="1">
                                    <!-- Alt+V -->
                                    <Grid Margin="0,0,0,8">
                                        <Border Background="#222" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left">
                                            <TextBlock Text="Alt + V" FontFamily="Consolas" FontSize="11" FontWeight="Bold" Foreground="#32CD32"/>
                                        </Border>
                                        <TextBlock Text="Paste AI Code into Editor" FontSize="11" Foreground="#dddddd"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>

                                    <!-- F8 -->
                                    <Grid Margin="0,0,0,8">
                                        <Border Background="#222" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left">
                                            <TextBlock Text="F8" FontFamily="Consolas" FontSize="11" FontWeight="Bold" Foreground="#32CD32"/>
                                        </Border>
                                        <TextBlock Text="Auto-Type (3s countdown)" FontSize="11" Foreground="#dddddd"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>

                                    <!-- Esc -->
                                    <Grid Margin="0,0,0,8">
                                        <Border Background="#222" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left">
                                            <TextBlock Text="Esc" FontFamily="Consolas" FontSize="11" FontWeight="Bold" Foreground="#ff5555"/>
                                        </Border>
                                        <TextBlock Text="Stop / Terminate Auto-Type" FontSize="11" Foreground="#ff8888"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>

                                    <!-- Alt+S -->
                                    <Grid Margin="0,0,0,8">
                                        <Border Background="#222" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left">
                                            <TextBlock Text="Alt + S" FontFamily="Consolas" FontSize="11" FontWeight="Bold" Foreground="#00cccc"/>
                                        </Border>
                                        <TextBlock Text="Capture Screen to Sidebar" FontSize="11" Foreground="#dddddd"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>

                                    <!-- Alt+~ -->
                                    <Grid Margin="0,0,0,8">
                                        <Border Background="#222" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left">
                                            <TextBlock Text="Alt + ~" FontFamily="Consolas" FontSize="11" FontWeight="Bold" Foreground="#ffaa00"/>
                                        </Border>
                                        <TextBlock Text="Stealth Hide / Show Overlay" FontSize="11" Foreground="#dddddd"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>

                                    <!-- Alt+Shift+Z -->
                                    <Grid Margin="0,0,0,8">
                                        <Border Background="#222" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left">
                                            <TextBlock Text="Alt+Shift+Z" FontFamily="Consolas" FontSize="11" FontWeight="Bold" Foreground="#ffaa00"/>
                                        </Border>
                                        <TextBlock Text="Alternative Stealth Toggle" FontSize="11" Foreground="#888888"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>

                                    <!-- Ctrl+C -->
                                    <Grid Margin="0,0,0,4">
                                        <Border Background="#222" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left">
                                            <TextBlock Text="Ctrl + C" FontFamily="Consolas" FontSize="11" FontWeight="Bold" Foreground="#aaaaaa"/>
                                        </Border>
                                        <TextBlock Text="Copy Code from AI" FontSize="11" Foreground="#aaaaaa"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                </StackPanel>

                                <!-- OK Button -->
                                <Button Grid.Row="2" Margin="0,12,0,0" Style="{StaticResource FlatBtn}"
                                        Background="#1a4a1a" Height="28"
                                        Click="CloseShortcuts_Click">
                                    <TextBlock Text="OK" FontWeight="Bold" Foreground="#32CD32" FontSize="12"/>
                                </Button>
                            </Grid>
                        </Border>
                    </Popup>
                </Grid>

                <!-- BOTTOM BAR -->
                <Grid Grid.Row="2" Background="#111111" MouseLeftButtonDown="Window_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Style="{StaticResource ActionBtn}" Click="CopyBtn_Click" ToolTip="Copy (Ctrl+C)">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="COPY" FontSize="10" FontWeight="SemiBold" Foreground="#aaaaaa" HorizontalAlignment="Center"/>
                            <TextBlock Text="Ctrl+C" FontSize="8" Foreground="#555" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="1" Style="{StaticResource ActionBtn}" Click="CaptureBtn_Click" ToolTip="Screenshot (Alt+S)">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="CAPTURE" FontSize="10" FontWeight="SemiBold" Foreground="#00cccc" HorizontalAlignment="Center"/>
                            <TextBlock Text="Alt+S" FontSize="8" Foreground="#555" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- PASTE BUTTON -->
                    <Button x:Name="PasteBtn" Grid.Column="2" Style="{StaticResource ActionBtn}" Background="#1a4a1a" Click="PasteBtn_Click" ToolTip="Paste directly to Code Editor (Alt+V)">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock x:Name="PasteBtnText" Text="PASTE" FontSize="10" FontWeight="SemiBold" Foreground="#32CD32" HorizontalAlignment="Center"/>
                            <TextBlock Text="Alt+V" FontSize="8" Foreground="#2a7a2a" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- STOP BUTTON (Red when active, terminates) -->
                    <Button x:Name="StopBtn" Grid.Column="3" Style="{StaticResource ActionBtn}" Click="StopBtn_Click" ToolTip="Terminate Auto-Type (Esc)">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock x:Name="StopBtnText" Text="STOP" FontSize="10" FontWeight="SemiBold" Foreground="#aaaaaa" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="StopBtnSub" Text="Esc" FontSize="8" Foreground="#555" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- AUTO-TYPE BUTTON (Green when active) -->
                    <Button x:Name="AutoTypeBtn" Grid.Column="4" Style="{StaticResource ActionBtn}" Click="AutoTypeBtn_Click" ToolTip="Auto-Type into Code Editor (F8)">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock x:Name="AutoTypeBtnText" Text="AUTO-TYPE" FontSize="10" FontWeight="SemiBold" Foreground="#aaaaaa" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="AutoTypeBtnSub" Text="F8" FontSize="8" Foreground="#555" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Border Grid.Column="5" Cursor="SizeNWSE" Background="Transparent"
                            MouseLeftButtonDown="ResizeGrip_MouseDown">
                        <TextBlock Text="⠿" Foreground="#444" FontSize="10"
                                   HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                   Margin="0,0,2,2"/>
                    </Border>
                </Grid>
            </Grid>

            <!-- ═══════════════════════════════════════════
                 SCREENSHOT SIDEBAR (Col 1)
            ════════════════════════════════════════════════ -->
            <Border x:Name="ScreenshotSidebar" Grid.Column="1"
                    Width="150" Visibility="Collapsed"
                    Background="#0d0d0d"
                    BorderBrush="#2a2a2a" BorderThickness="1,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="34"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Sidebar header -->
                    <Grid Grid.Row="0" Background="#111111">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                            <TextBlock Text="⬛ " FontSize="9" Foreground="#555" VerticalAlignment="Center"/>
                            <TextBlock Text="SHOTS" FontSize="10" FontWeight="SemiBold" Foreground="#888" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                                Style="{StaticResource FlatBtn}" Foreground="#555" FontSize="10"
                                Content="CLR" Padding="4,0" Height="20" Margin="0,0,4,0"
                                Click="ClearShots_Click"/>
                    </Grid>

                    <!-- Thumbnails scroll area -->
                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="ThumbnailsPanel" Margin="6,6,6,0"/>
                    </ScrollViewer>

                    <!-- Drop hint at bottom -->
                    <Border Grid.Row="2" Background="#111" Padding="4,6">
                        <TextBlock Text="Drag to chat ↑" FontSize="9" Foreground="#444"
                                   HorizontalAlignment="Center" TextWrapping="Wrap"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>