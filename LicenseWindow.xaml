<Window x:Class="MyOverlayPOC.LicenseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title=""
        Width="440" Height="340"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True">

    <!-- Drop-shadow wrapper -->
    <Border Margin="12" CornerRadius="12"
            Background="#1A1A1A"
            BorderBrush="#32CD32" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="0" Color="#000000" Opacity="0.7"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Titlebar -->
            <Border Grid.Row="0" CornerRadius="12,12,0,0" Background="#111111"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="16,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="8" Height="8" Fill="#32CD32" Margin="0,0,8,0">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Style.Triggers>
                                        <EventTrigger RoutedEvent="Loaded">
                                            <BeginStoryboard>
                                                <Storyboard RepeatBehavior="Forever">
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                     From="1" To="0.2" Duration="0:0:0.8"
                                                                     AutoReverse="True"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="ELUDER — License"
                                   Foreground="#AAAAAA" FontSize="11"
                                   FontFamily="Segoe UI" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Content="✕" HorizontalAlignment="Right"
                            Background="Transparent" BorderThickness="0"
                            Foreground="#555555" FontSize="13"
                            Cursor="Hand" Click="CloseButton_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Foreground" Value="#555555"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" Padding="6,2">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#CC3333"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>

            <!-- Body -->
            <StackPanel Grid.Row="1" Margin="32,24,32,24" VerticalAlignment="Center">

                <TextBlock x:Name="InputLabel"
                           Text="Enter your access token"
                           Foreground="#DDDDDD" FontSize="15" FontWeight="SemiBold"
                           FontFamily="Segoe UI" Margin="0,0,0,6"/>

                <TextBlock x:Name="SubLabel"
                           Text="Your token will be permanently bound to this device."
                           Foreground="#666666" FontSize="11" FontFamily="Segoe UI"
                           Margin="0,0,0,20" TextWrapping="Wrap"/>

                <!-- Token input -->
                <Border x:Name="TokenInputBorder"
                        BorderBrush="#333333" BorderThickness="1" CornerRadius="6"
                        Background="#111111" Margin="0,0,0,16">
                    <TextBox x:Name="TokenInput"
                             Background="Transparent" BorderThickness="0"
                             Foreground="#32CD32" CaretBrush="#32CD32"
                             FontFamily="Consolas" FontSize="13"
                             Padding="12,10"
                             VerticalContentAlignment="Center"
                             MaxLength="64"
                             KeyDown="TokenInput_KeyDown"/>
                </Border>

                <!-- Status label -->
                <TextBlock x:Name="StatusLabel"
                           Foreground="#666666" FontSize="11"
                           FontFamily="Segoe UI" Margin="0,0,0,12"
                           TextWrapping="Wrap" MinHeight="16"/>

                <!-- Telegram contact button (shown only on HWID mismatch) -->
                <Button x:Name="TelegramButton"
                        Visibility="Collapsed"
                        Height="36" Margin="0,0,0,12"
                        Click="TelegramButton_Click" Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#0a1a2e"/>
                            <Setter Property="BorderBrush" Value="#2d78e3"/>
                            <Setter Property="Foreground" Value="#6aadf5"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Setter Property="FontFamily" Value="Segoe UI"/>
                            <Setter Property="FontSize" Value="13"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="6">
                                            <StackPanel Orientation="Horizontal"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center">
                                                <TextBlock Text="✈" FontSize="15" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <TextBlock Text="DM @Hackerseb on Telegram" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="#112244"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- Activate button -->
                <Button x:Name="ActivateButton"
                        Content="Activate" Height="38"
                        Click="ActivateButton_Click" Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#1E3A1E"/>
                            <Setter Property="Foreground" Value="#32CD32"/>
                            <Setter Property="BorderBrush" Value="#32CD32"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Setter Property="FontFamily" Value="Segoe UI"/>
                            <Setter Property="FontSize" Value="13"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="6">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="#2A4D2A"/>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="bd" Property="Background" Value="#1A1A1A"/>
                                                <Setter Property="Foreground" Value="#444444"/>
                                                <Setter TargetName="bd" Property="BorderBrush" Value="#333333"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>

            </StackPanel>
        </Grid>
    </Border>
</Window>
